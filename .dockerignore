# Keep the build context small and keep local state out of the image.
# Runtime data lives on the Fly volume, not in the image.

node_modules
data
*.log
deploy-output.txt

# VCS / editor
.git
.gitignore
.DS_Store
.idea
.vscode

# Local env — NEVER bake secrets into the image. Use `flyctl secrets set`.
.env
.env.*
.npmrc

# Tests & dev-only tooling (not needed at runtime)
tests
test
coverage
.nyc_output

# One-off deploy helpers from the retired pre-Fly VM flow (unused on Fly)
deploy.js
deploy-*.js
deploy-to-vm.sh
deploy-to-vm.py
recover-*.js
ecosystem.config.js

# Docs / specs don't need to ship in the runtime image.
# NOTE: exclude docs/ via a glob (docs/**), NOT the bare `docs` dir name —
# Docker won't descend into a directory excluded by name, so leaf-file
# re-includes (!docs/FOO.md) below would be ignored. With docs/** the
# directory is still walked, so the 4 served legal files can be un-ignored.
docs/**
specs
reviews
sprints
agents
prompts
outputs
*.md

# Re-include ONLY the legal markdown that serveLegalPage reads from /app/docs.
# Everything else under docs/ stays excluded. These stay untracked in git;
# .dockerignore only affects the build context, not the repo.
!docs/TERMS-OF-SERVICE.md
!docs/PRIVACY-POLICY.md
!docs/SUBPROCESSORS.md
!docs/SUPPORTED-CLIENTS.md
!docs/DMCA-POLICY.md

# Never bake data tarballs into the image
*.tgz
