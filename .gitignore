# no trailing slash — also ignores a node_modules SYMLINK (dev worktrees link
# a sibling checkout's install; the slash form matches directories only)
node_modules
data/
*.log
.DS_Store
.npmrc

# Never commit secrets, local runtime data, or internal analysis to this PUBLIC repo.
# (Hardened after the 2026-07-01 recover-from-Fly leak.)
.env
.env.*
*.tgz
/outputs/
.claude/

# Foundry build tree (contracts/): never commit artifacts, vendored libs, or
# broadcast logs to this PUBLIC repo. Source .sol, README, and deploy docs ARE tracked.
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/
contracts/lcov.info
