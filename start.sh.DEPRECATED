#!/bin/bash
# ============================================================================
# DEPRECATED — Conway/PM2 relic, DO NOT USE. Deploy is via Fly; see README.
# ----------------------------------------------------------------------------
# This starts the server under PM2 on a Conway VM (cd /app, ~/.conway/wallet.json,
# ecosystem.config.js). Production runs on Fly.io from the Dockerfile
# (tini → docker-entrypoint.sh → su-exec → node server.js). Kept for history only.
# ============================================================================
# ─── Auxilo Production Start Script ──────────────────────────────────
# Starts Auxilo server + health monitor via PM2.
# All env vars are exported here so PM2 inherits them.
# Usage:
#   ./start.sh         — start or restart all processes
#   ./start.sh stop    — graceful stop all processes
#   ./start.sh status  — show PM2 process list
#   ./start.sh logs    — tail all PM2 logs
# ─────────────────────────────────────────────────────────────────────
set -euo pipefail
cd /app

# ─── Action Dispatch ─────────────────────────────────────────────────
ACTION="${1:-start}"

case "$ACTION" in
  stop)
    echo "[start.sh] Stopping Auxilo processes..."
    pm2 stop ecosystem.config.js 2>/dev/null || true
    pm2 delete ecosystem.config.js 2>/dev/null || true
    echo "[start.sh] All processes stopped."
    exit 0
    ;;
  status)
    pm2 list
    exit 0
    ;;
  logs)
    pm2 logs --lines 50
    exit 0
    ;;
  start|restart)
    # Continue below
    ;;
  *)
    echo "Usage: $0 {start|stop|status|logs}"
    exit 1
    ;;
esac

# ─── Environment Variables ───────────────────────────────────────────
# TLS cert bundle for Conway VM HTTPS requests
export NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

# Wallet private key — read from Conway wallet config
if [ -z "${WALLET_PRIVATE_KEY:-}" ]; then
  if [ -f "$HOME/.conway/wallet.json" ]; then
    export WALLET_PRIVATE_KEY=$(node -pe 'JSON.parse(require("fs").readFileSync(process.env.HOME + "/.conway/wallet.json", "utf8")).privateKey')
    echo "[start.sh] WALLET_PRIVATE_KEY loaded from ~/.conway/wallet.json"
  else
    echo "[start.sh] WARNING: WALLET_PRIVATE_KEY not set and ~/.conway/wallet.json not found"
    echo "[start.sh] On-chain operations will fail."
  fi
fi

# Session secret — reuse existing or generate new
if [ -z "${SESSION_SECRET:-}" ]; then
  # Check if we saved one from a previous run
  if [ -f /app/data/.session-secret ]; then
    export SESSION_SECRET=$(cat /app/data/.session-secret)
    echo "[start.sh] SESSION_SECRET loaded from saved state"
  else
    export SESSION_SECRET=$(openssl rand -hex 32)
    echo "$SESSION_SECRET" > /app/data/.session-secret
    chmod 600 /app/data/.session-secret
    echo "[start.sh] SESSION_SECRET generated and saved"
  fi
fi

# Production mode
export NODE_ENV=production

# ─── Directory Setup ─────────────────────────────────────────────────
mkdir -p /app/logs
mkdir -p /app/data
mkdir -p /app/scripts

# ─── PM2 Setup ───────────────────────────────────────────────────────
# Check PM2 is available
if ! command -v pm2 &> /dev/null; then
  echo "[start.sh] PM2 not found. Installing..."
  npm install pm2 -g
fi

# Install log rotation module (idempotent — skips if already installed)
pm2 install pm2-logrotate 2>/dev/null || true

# Configure log rotation (idempotent — safe to re-run)
pm2 set pm2-logrotate:max_size 10M 2>/dev/null || true
pm2 set pm2-logrotate:retain 7 2>/dev/null || true
pm2 set pm2-logrotate:compress true 2>/dev/null || true
pm2 set pm2-logrotate:workerInterval 60 2>/dev/null || true
pm2 set pm2-logrotate:dateFormat YYYY-MM-DD_HH-mm-ss 2>/dev/null || true
pm2 set pm2-logrotate:rotateInterval '0 0 * * *' 2>/dev/null || true

# ─── Start / Restart ─────────────────────────────────────────────────
echo "[start.sh] Starting Auxilo via PM2..."

# Delete existing processes to ensure clean state with current env vars
pm2 delete ecosystem.config.js 2>/dev/null || true

# Start all apps defined in ecosystem.config.js
pm2 start ecosystem.config.js

# Save process list so PM2 resurrects on reboot (if pm2 startup was configured)
pm2 save

# ─── Verify ──────────────────────────────────────────────────────────
sleep 3
pm2 list

echo ""
echo "[start.sh] Auxilo started. Commands:"
echo "  pm2 list           — process status"
echo "  pm2 logs auxilo    — tail server logs"
echo "  pm2 logs           — tail all logs"
echo "  pm2 monit          — live monitoring dashboard"
echo "  ./start.sh stop    — graceful shutdown"
echo "  ./start.sh status  — quick status check"
